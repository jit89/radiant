# Copy to .env in this repo (~/claude-coding-workflow/.env, chmod 600), not into
# a target project: a live .env in a target checkout stops a walk
# (secrets-in-checkout). Never commit .env.

# Implementer (required by default; only the fallback with IMPLEMENTER_PRIMARY=haiku).
DEEPSEEK_API_KEY=

# Claude launchers: optional. They also accept `claude login` OAuth.
# ANTHROPIC_API_KEY=
