+
+fn panic_text(e: Box<dyn std::any::Any + Send>) -> String {
+    if let Some(s) = e.downcast_ref::<&str>() {
+        s.to_string()
+    } else if let Some(s) = e.downcast_ref::<String>() {
+        s.clone()
+    } else {
+        String::new()
+    }
+}
+
+#[test]
+fn lib_overflow_panics() {
+    let e = std::panic::catch_unwind(|| total_secs(3_000_000_000, 2_000_000_000)).unwrap_err();
+    assert!(panic_text(e).contains("overflow"));
+}
+
+#[test]
+fn oracle_overflow_panics() {
+    let e = std::panic::catch_unwind(|| std::hint::black_box(3_000_000_000u32) + std::hint::black_box(2_000_000_000u32)).unwrap_err();
+    assert!(panic_text(e).contains("overflow"));
+}
